{
  "info": {
    "name": "Apprendo — API",
    "description": "API de la marketplace de formations Apprendo (Laravel 12, Sanctum, DomPDF). Lancez d’abord une requête de connexion : le jeton est enregistré dans {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentification",
      "item": [
        {
          "name": "Inscription apprenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "role : apprenant | formateur",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Awa Test\",\n  \"email\": \"awa@exemple.bj\",\n  \"password\": \"motdepasse\",\n  \"role\": \"apprenant\"\n}"
            }
          }
        },
        {
          "name": "Connexion (démo apprenante)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Enregistre automatiquement le jeton dans la variable {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"apprenant@apprendo.bj\",\n  \"password\": \"demo1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) { pm.collectionVariables.set(\"token\", d.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion (démo formateur)",
          "request": {
            "method": "POST",
            "header": [
              {
